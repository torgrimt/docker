## Copy this file to .env
#
## Loki push endpoint: the URL carries the /loki/api/v1/push path and the
## credentials are the basic-auth user in front of the central Loki.
## One Alloy per site, each with its own CLUSTER_NAME label.

ALLOY_CLUSTER_NAME=your-cluster
ALLOY_LOKI_URL=https://loki.example.com/loki/api/v1/push
ALLOY_LOKI_USER=your-user
ALLOY_LOKI_PASS=
