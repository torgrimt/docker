// Ships this host's docker container logs and any syslog it receives
// (UDP/TCP 1514) to the central Loki on red. Cluster label: nl-home.

logging {
  level  = "info"
  format = "logfmt"
}

// ---- docker container logs -------------------------------------------------

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }
  rule {
    target_label = "job"
    replacement  = "docker"
  }
  rule {
    target_label = "cluster"
    replacement  = sys.env("CLUSTER_NAME")
  }
}

loki.source.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.docker.containers.targets
  relabel_rules    = discovery.relabel.docker.rules
  refresh_interval = "30s"
  forward_to       = [loki.process.filter.receiver]
}

// ---- syslog from switches, routers and appliances --------------------------
// The listener is "raw": the ZX530S (KT-NOS) puts a year in its timestamp
// ("<pri>*Oct 28 2026 18:26:35: %AAA-5-CONNECT: ..."), which no RFC3164
// parser accepts, and a rejected line is dropped before any stage runs.
// Raw passes every line through untouched and the regex below parses the
// header where it matches. A stage timestamp is deliberately not used: a
// non-matching sender would then lose its entries. Loki stamps arrival time.

discovery.relabel "syslog" {
  targets = []

  rule {
    target_label = "job"
    replacement  = "syslog"
  }
  rule {
    target_label = "cluster"
    replacement  = sys.env("CLUSTER_NAME")
  }
}

loki.source.syslog "network" {
  listener {
    address       = "0.0.0.0:1514"
    protocol      = "udp"
    syslog_format = "raw"
  }
  listener {
    address       = "0.0.0.0:1514"
    protocol      = "tcp"
    syslog_format = "raw"
  }

  relabel_rules = discovery.relabel.syslog.rules
  forward_to    = [loki.process.filter.receiver]
}

// ---- filtering and parsing -------------------------------------------------
// Container log files are read from the start on first run, which means weeks
// of history; Loki rejects samples older than reject_old_samples_max_age, so
// drop anything outside the ingest window instead of retrying it forever.
//
// KT-NOS header: "<189>*Oct 28 2026 18:26:35: %AAA-5-CONNECT: ..." — no
// hostname field, so the priority prefix is optional in the pattern and the
// useful parts become labels. Lines that do not match pass through untouched.

loki.process "filter" {
  stage.regex {
    expression = `^(?:<[0-9]{1,3}>)?\*?(?P<timestamp>[A-Z][a-z]{2} +[0-9]{1,2} [0-9]{4} [0-9]{2}:[0-9]{2}:[0-9]{2}): %(?P<app>[A-Za-z0-9_]+)-(?P<severity>[0-9])-(?P<mnemonic>[A-Za-z0-9_-]+): (?P<message>.*)$`
  }

  stage.labels {
    values = {
      app      = "",
      severity = "",
      mnemonic = "",
    }
  }

  stage.drop {
    older_than          = "168h"
    drop_counter_reason = "older_than_ingest_window"
  }

  forward_to = [loki.write.loki.receiver]
}

// ---- output ----------------------------------------------------------------

loki.write "loki" {
  endpoint {
    url = sys.env("LOKI_URL")

    basic_auth {
      username = sys.env("LOKI_USER")
      password = sys.env("LOKI_PASS")
    }
  }

  external_labels = {
    cluster = sys.env("CLUSTER_NAME"),
  }
}
